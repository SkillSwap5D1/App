rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for university user verification
    function isUniversityUser() {
      return request.auth != null && 
             (
               (request.auth.token.isUniversityUser == true &&
                request.auth.token.emailDomain == 'myport.ac.uk') ||
               request.auth.token.email.matches('.*@myport\\.ac\\.uk$')
             );
    }

    function isSelf(userId) {
      return request.auth != null && userId == request.auth.uid;
    }

    function hasUniversityEmail() {
      return request.auth != null &&
             request.auth.token.email.matches('.*@myport\\.ac\\.uk$');
    }

    function isConversationParticipant(conversationId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // Users collection - Profile management
    match /users/{userId} {
      allow read: if isUniversityUser() || isSelf(userId);
      allow create: if isSelf(userId) && hasUniversityEmail();
      allow update, delete: if isUniversityUser() || isSelf(userId);
    }

    // Listings - Skill offerings
    match /listings/{listingId} {
      allow read: if isUniversityUser();
      allow create: if isUniversityUser();
      allow update, delete: if isUniversityUser() && resource.data.ownerId == request.auth.uid;
    }

    // Requests - Lesson requests between users
    match /requests/{requestId} {
      allow read: if isUniversityUser() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isUniversityUser();
      allow update, delete: if isUniversityUser() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // Messages - Private messaging
    match /messages/{messageId} {
      allow read: if isUniversityUser() && (
        resource.data.senderId == request.auth.uid ||
        isConversationParticipant(resource.data.conversationId)
      );
      allow create: if isUniversityUser() &&
        request.resource.data.senderId == request.auth.uid &&
        isConversationParticipant(request.resource.data.conversationId);
      allow update: if false;
      allow delete: if isUniversityUser() && resource.data.senderId == request.auth.uid;
    }

    // Reviews - Skill provider ratings
    match /reviews/{reviewId} {
      allow read: if isUniversityUser();
      allow create: if isUniversityUser();
      allow update: if isUniversityUser() && resource.data.reviewerId == request.auth.uid;
      allow delete: if isUniversityUser() && resource.data.reviewerId == request.auth.uid;
    }

    // Blocks - User blocking
    match /blocks/{blockId} {
      allow read: if isUniversityUser() && blockId == request.auth.uid;
      allow create, delete: if isUniversityUser();
    }

    // Reports - Content moderation
    match /reports/{reportId} {
      allow read: if isUniversityUser() && resource.data.reporterId == request.auth.uid;
      allow create: if isUniversityUser();
    }

    // Notifications - User alerts
    match /notifications/{notificationId} {
      allow read, update: if isUniversityUser() && resource.data.userId == request.auth.uid;
      allow delete: if isUniversityUser() && resource.data.userId == request.auth.uid;
    }

    // Availability - User availability slots
    match /availability/{availabilityId} {
      allow read: if isUniversityUser();
      allow write: if isUniversityUser() && availabilityId == request.auth.uid;
    }

    // Sessions - Completed lessons
    match /sessions/{sessionId} {
      allow read: if isUniversityUser() && (
        resource.data.providerId == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isUniversityUser();
      allow update: if isUniversityUser() && (
        resource.data.providerId == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );
    }

    // Conversations - Chat threads
    match /conversations/{conversationId} {
      allow read, create, update: if request.auth != null;
    }

    // Catch-all deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
