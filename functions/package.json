{
  "name": "skillswap-functions",
  "description": "Cloud Functions for SkillSwap - University Email Verification",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions --project=cw-skillswap",
    "logs": "firebase functions:log --project=cw-skillswap"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.4.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
